#!/usr/bin/env python3
"""The laptop battery's charge limit (Settings → Power), where the battery supports one
(/sys/class/power_supply/BAT*/charge_control_end_threshold).

  tide-power charge-limit              JSON: supported, limit (percent)
  tide-power charge-limit <percent>    set it (one password prompt): now, and at every
                                       start through a udev rule; 100 removes the rule
"""
import glob, json, os, subprocess, sys

RULE = "/etc/udev/rules.d/90-tide-charge-limit.rules"


def files():
    return sorted(glob.glob("/sys/class/power_supply/BAT*/charge_control_end_threshold"))


def status():
    fs = files()
    limit = 100
    if fs:
        try:
            limit = int(open(fs[0]).read().strip())
        except (OSError, ValueError):
            pass
    print(json.dumps({"supported": bool(fs), "limit": limit}))
    return 0


def set_limit(pct):
    if not files():
        print(json.dumps({"error": "This battery has no charge limit"}))
        return 1
    r = subprocess.run(["pkexec", os.path.abspath(__file__), "root-set", str(pct)], capture_output=True, text=True)
    if r.returncode != 0:
        print(json.dumps({"error": "Not changed" if r.returncode in (126, 127) else (r.stderr.strip()[-200:] or "Couldn't change it")}))
        return 1
    return status()


def root_set(pct):
    if os.geteuid() != 0:
        return 1
    pct = max(50, min(100, int(pct)))
    for f in files():
        with open(f, "w") as fh:
            fh.write(str(pct))
    if pct >= 100:
        if os.path.exists(RULE):
            os.remove(RULE)
    else:
        with open(RULE, "w") as fh:
            fh.write("# Tide (Settings → Power): stop charging at %d%%\n"
                     'SUBSYSTEM=="power_supply", KERNEL=="BAT*", ATTR{charge_control_end_threshold}="%d"\n' % (pct, pct))
    return 0


def main(a):
    if a[:1] == ["charge-limit"]:
        return set_limit(a[1]) if len(a) > 1 else status()
    if a[:1] == ["root-set"] and len(a) > 1:
        return root_set(a[1])
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

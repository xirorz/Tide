#!/usr/bin/env python3
"""The laptop battery's charge limit (Settings → Power), where the battery supports one
(/sys/class/power_supply/BAT*/charge_control_end_threshold).

The setting belongs to the system, so the first change asks for the password once: a
udev rule then lets this user change it, and later changes need none. The battery
forgets it at every start; Tide keeps it (~/.local/state/tide/charge-limit) and sets it
again at login (`tide-power apply`).

  tide-power charge-limit              JSON: supported, limit (percent), writable
  tide-power charge-limit <percent>    set it (50-100; 100 = charge to full)
  tide-power apply                     set the kept limit again (login)
"""
import glob, json, os, subprocess, sys
from pathlib import Path

RULE = "/etc/udev/rules.d/90-tide-charge-limit.rules"
HELPER = "/usr/lib/tide/tide-root"
UNIT = "/etc/systemd/system/tide-charge-limit.service"
KEPT = Path.home() / ".local/state/tide/charge-limit"


def files():
    return sorted(glob.glob("/sys/class/power_supply/BAT*/charge_control_end_threshold"))


def writable():
    fs = files()
    return bool(fs) and all(os.access(f, os.W_OK) for f in fs)


def current():
    try:
        return int(open(files()[0]).read().strip())
    except (OSError, ValueError, IndexError):
        return 100


def needs_setup():
    """The password is needed: the limit isn't this user's to change yet, or it was set
    up before the boot unit existed (once more, to add it)."""
    return not writable() or (os.path.exists(HELPER) and not os.path.exists(UNIT))


def status(note=None):
    # "writable": a change needs no password (Settings steps aside when it does)
    d = {"supported": bool(files()), "limit": current(), "writable": not needs_setup()}
    if note:
        d["note"] = note
    print(json.dumps(d))
    return 0


def write(pct):
    for f in files():
        with open(f, "w") as fh:
            fh.write(str(pct))


def set_limit(pct):
    if not files():
        print(json.dumps({"error": "This battery has no charge limit"}))
        return 1
    try:
        pct = max(50, min(100, int(pct)))
    except ValueError:
        print(json.dumps({"error": "The limit is a percent (50-100)"}))
        return 1
    note = None
    if needs_setup():
        # once: let this user change it from now on (one password prompt). Tide's root
        # helper (/usr/lib/tide, put there by the installer) does it; an install from
        # before the helper falls back to this file once and says to run the installer
        if os.path.exists(HELPER):
            cmd = ["pkexec", HELPER, "power-setup", str(os.getuid())]
        else:
            cmd = ["pkexec", os.path.abspath(__file__), "root-setup", str(os.getuid())]
            note = "Run Tide's installer again so the password window names Tide's own helper"
        r = subprocess.run(cmd, capture_output=True, text=True)
        if r.returncode != 0 or not writable():
            print(json.dumps({"error": "Not changed" if r.returncode in (126, 127) else (r.stderr.strip()[-200:] or "Couldn't change it")}))
            return 1
    try:
        write(pct)
    except OSError as e:
        print(json.dumps({"error": f"Couldn't change it: {e.strerror}"}))
        return 1
    KEPT.parent.mkdir(parents=True, exist_ok=True)
    KEPT.write_text(str(pct) + "\n")
    return status(note)


def apply():
    try:
        pct = int(KEPT.read_text().strip())
    except (OSError, ValueError):
        return 0
    if files() and writable() and current() != pct:
        try:
            write(pct)
        except OSError:
            pass
    return 0


def root_setup(uid):
    """As root (pkexec), once: the threshold files belong to this user, now and at every start.
    Only for installs without Tide's root helper (/usr/lib/tide/tide-root)."""
    if os.geteuid() != 0:
        return 1
    uid = int(uid)
    with open(RULE, "w") as fh:
        fh.write("# Tide (Settings → Power): the battery's charge limit can be changed by user %d\n"
                 'ACTION=="add", SUBSYSTEM=="power_supply", KERNEL=="BAT*", RUN+="/bin/chown %d /sys%%p/charge_control_end_threshold"\n' % (uid, uid))
    for f in files():
        os.chown(f, uid, -1)
    return 0


def main(a):
    if a[:1] == ["charge-limit"]:
        return set_limit(a[1]) if len(a) > 1 else status()
    if a[:1] == ["apply"]:
        return apply()
    if a[:1] == ["root-setup"] and len(a) > 1:
        return root_setup(a[1])
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

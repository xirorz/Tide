#!/usr/bin/env python3
"""Tinted, for your apps too (Settings → Appearance: Tinted, with "Apply the dark theme
to all apps" on): GTK and Qt apps take the wallpaper's colours Tide uses
(~/.config/Tide/colors/colors.css).

GTK 3 and 4: ~/.config/gtk-*/gtk.css loads what it loaded before (your theme), then
Tide's colours (named colours: accent, window, view, header bar, sidebar, popovers).
The old gtk.css (a file or a link to a theme) is kept as gtk.css.before-tide-tint and
put back by `off`. Nothing in the theme itself is touched.

Qt (qt5ct / qt6ct, where they're set up): their colour scheme becomes Tide's
(~/.config/Tide/colors/qt-tint.conf); the previous one is kept and put back by `off`.
Styles that draw their own colours (Kvantum) keep theirs.

Apps pick it up when they next open a window or start.

  tide-apptint on        tint your apps
  tide-apptint off       put back what was there
  tide-apptint refresh   new wallpaper colours (only while on)
  tide-apptint follow    on when Tide is Tinted and apps are dark, off otherwise
  tide-apptint status
"""
import configparser, json, os, re, sys
from pathlib import Path

HOME = Path.home()
TIDE = HOME / ".config/Tide"
COLORS = TIDE / "colors/colors.css"
GTK_TINT = TIDE / "colors/gtk-tint.css"
QT_TINT = TIDE / "colors/qt-tint.conf"
STATE = HOME / ".local/state/tide/apptint.json"
MARK = "/* Tide: tinted apps (bin/tide-apptint) */"
GTK_DIRS = [HOME / ".config/gtk-3.0", HOME / ".config/gtk-4.0"]
QT_CONFS = [HOME / ".config/qt5ct/qt5ct.conf", HOME / ".config/qt6ct/qt6ct.conf"]


def palette():
    text = COLORS.read_text()
    return {k: v for k, v in re.findall(r"--([a-z-]+):\s*(#[0-9a-fA-F]{6})", text)}


def mix(a, b, t):
    a, b = [int(a[i:i + 2], 16) for i in (1, 3, 5)], [int(b[i:i + 2], 16) for i in (1, 3, 5)]
    return "#%02x%02x%02x" % tuple(round(x + (y - x) * t) for x, y in zip(a, b))


def write_tints():
    c = palette()
    fg, bg, p = c.get("foreground", "#e6e6e6"), c.get("background", "#141414"), c.get("primary", "#3c8ce0")
    on_p = c.get("on-primary", "#000000")
    low = c.get("surface-low", mix(bg, fg, 0.04))
    cont = c.get("surface-container", mix(bg, fg, 0.07))
    high = c.get("surface-high", mix(bg, fg, 0.11))
    lowest = c.get("surface-lowest", mix(bg, "#000000", 0.3))
    outline = c.get("outline-variant", mix(bg, fg, 0.2))
    err = c.get("error", "#ffb4ab")
    named = {
        # libadwaita (GTK 4) and GTK 3 Adwaita-style names
        "accent_color": p, "accent_bg_color": p, "accent_fg_color": on_p,
        "window_bg_color": bg, "window_fg_color": fg,
        "view_bg_color": low, "view_fg_color": fg,
        "headerbar_bg_color": cont, "headerbar_fg_color": fg, "headerbar_backdrop_color": bg,
        "sidebar_bg_color": lowest, "sidebar_fg_color": fg, "secondary_sidebar_bg_color": low,
        "card_bg_color": cont, "card_fg_color": fg,
        "popover_bg_color": high, "popover_fg_color": fg,
        "dialog_bg_color": cont, "dialog_fg_color": fg,
        "destructive_color": err, "error_color": err,
        "theme_bg_color": bg, "theme_fg_color": fg, "theme_base_color": low, "theme_text_color": fg,
        "theme_selected_bg_color": p, "theme_selected_fg_color": on_p,
        "borders": outline, "unfocused_borders": outline,
    }
    GTK_TINT.write_text(MARK + "\n" + "".join(f"@define-color {k} {v};\n" for k, v in named.items()))
    # Qt: WindowText, Button, Light, Midlight, Dark, Mid, Text, BrightText, ButtonText, Base,
    # Window, Shadow, Highlight, HighlightedText, Link, LinkVisited, AlternateBase, NoRole,
    # ToolTipBase, ToolTipText, PlaceholderText
    dim = mix(fg, bg, 0.5)
    row = [fg, cont, high, mix(cont, high, 0.5), lowest, mix(bg, cont, 0.5), fg, "#ffffff", fg, low,
           bg, "#000000", p, on_p, p, mix(p, fg, 0.3), cont, bg, high, fg, dim]
    argb = lambda cols: ", ".join("#ff" + x[1:] for x in cols)
    off = [dim if i in (0, 6, 8, 13) else x for i, x in enumerate(row)]
    QT_TINT.write_text("[ColorScheme]\nactive_colors=%s\ndisabled_colors=%s\ninactive_colors=%s\n" % (argb(row), argb(off), argb(row)))


def state():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}


def save_state(s):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(s, indent=1))


def gtk_on(d):
    css = d / "gtk.css"
    keep = d / "gtk.css.before-tide-tint"
    if css.is_file() and MARK in css.read_text(errors="replace") and not css.is_symlink():
        return                                          # already Tide's
    d.mkdir(parents=True, exist_ok=True)
    imports = []
    if css.is_symlink() or css.exists():
        if not keep.exists() and not keep.is_symlink():
            css.rename(keep)
        else:
            css.unlink()
        target = Path(os.path.realpath(keep)) if keep.is_symlink() else keep
        if target.is_file():
            imports.append(target)
    css.write_text(MARK + "\n" + "".join(f'@import url("file://{t}");\n' for t in imports)
                   + f'@import url("file://{GTK_TINT}");\n')


def gtk_off(d):
    css, keep = d / "gtk.css", d / "gtk.css.before-tide-tint"
    if css.is_file() and not css.is_symlink() and MARK in css.read_text(errors="replace"):
        css.unlink()
        if keep.exists() or keep.is_symlink():
            keep.rename(css)


def qt_set(conf, path, custom):
    text = conf.read_text()
    text = re.sub(r"(?m)^color_scheme_path=.*$", "color_scheme_path=" + path, text) if "color_scheme_path=" in text \
        else text.replace("[Appearance]\n", "[Appearance]\ncolor_scheme_path=" + path + "\n", 1)
    text = re.sub(r"(?m)^custom_palette=.*$", "custom_palette=" + custom, text) if "custom_palette=" in text \
        else text.replace("[Appearance]\n", "[Appearance]\ncustom_palette=" + custom + "\n", 1)
    conf.write_text(text)


def qt_get(conf):
    text = conf.read_text()
    a = re.search(r"(?m)^color_scheme_path=(.*)$", text)
    b = re.search(r"(?m)^custom_palette=(.*)$", text)
    return {"path": a.group(1) if a else "", "custom": b.group(1) if b else "false"}


def on():
    write_tints()
    s = state()
    s.setdefault("qt", {})
    for d in GTK_DIRS:
        gtk_on(d)
    for conf in QT_CONFS:
        if not conf.is_file():
            continue
        cur = qt_get(conf)
        if cur["path"] != str(QT_TINT) and str(conf) not in s["qt"]:
            s["qt"][str(conf)] = cur
        qt_set(conf, str(QT_TINT), "true")
    s["on"] = True
    save_state(s)
    print("tide-apptint: on")


def off():
    s = state()
    for d in GTK_DIRS:
        gtk_off(d)
    for conf, prev in (s.get("qt") or {}).items():
        conf = Path(conf)
        if conf.is_file() and qt_get(conf)["path"] == str(QT_TINT):
            qt_set(conf, prev.get("path", ""), prev.get("custom", "false"))
    save_state({"on": False})
    print("tide-apptint: off")


def main(a):
    if a == ["on"]:
        on()
    elif a == ["off"]:
        off()
    elif a == ["follow"]:
        import subprocess
        try:
            surface = json.loads((TIDE / "modes/dev/theme.json").read_text()).get("surface", "dark")
        except (OSError, ValueError):
            surface = "dark"
        scheme = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", "color-scheme"],
                                capture_output=True, text=True).stdout
        if surface == "tinted" and "prefer-dark" in scheme:
            on()
        elif state().get("on"):
            off()
    elif a == ["refresh"]:
        if state().get("on"):
            write_tints()
    elif a == ["status"]:
        print(json.dumps({"on": bool(state().get("on"))}))
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

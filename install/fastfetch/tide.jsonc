// Tide's terminal greeting (bin/tide-greet): the breaking wave and a few lines about
// this computer. bin/tide-greet passes the logo and its colors (from the wallpaper).
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "padding": { "top": 0, "left": 1, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "key": { "width": 7 }
    },
    "modules": [
        "title",
        "separator",
        { "type": "os", "key": "os", "format": "{name}" },
        { "type": "wm", "key": "wm", "format": "{pretty-name} {version}" },
        { "type": "shell", "key": "shell", "format": "{pretty-name}" },
        { "type": "terminal", "key": "term", "format": "{pretty-name}" },
        { "type": "uptime", "key": "up" }
    ]
}

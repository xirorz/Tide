// Tide's terminal greeting (bin/tide-greet): the breaking wave and everything about
// this computer at a glance. bin/tide-greet passes the logo and its colors (from the
// wallpaper). Modules a computer doesn't have (a battery on a desktop) don't show.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "padding": { "top": 1, "left": 1, "right": 3 }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        { "type": "datetime", "key": "Time", "format": "{weekday-short} {month-name-short} {day-in-month}, {hour-12}:{minute-pretty} {am-pm}" },
        "packages",
        "shell",
        "display",
        "wm",
        "theme",
        "icons",
        "font",
        "cursor",
        "terminal",
        "terminalfont",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "localip",
        "battery",
        "poweradapter",
        "locale",
        "break",
        { "type": "colors", "symbol": "circle" }
    ]
}
